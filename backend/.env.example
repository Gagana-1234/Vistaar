# ─────────────────────────────────────────────────────────────────
# Vistaar — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────

# ── Gemini AI (required for LLM reasoning and chat)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────
# Cognee Memory Layer (optional — system works without this)
# If not set, Cognee memory features are disabled gracefully.
# ─────────────────────────────────────────────────────────────────

# LLM provider for Cognee's knowledge graph construction
# Options: openai | google | anthropic | ollama
COGNEE_LLM_PROVIDER=openai

# API key for Cognee's LLM (can be same as GEMINI_API_KEY if using google provider)
COGNEE_LLM_API_KEY=your_openai_or_gemini_api_key_here

# Model name for Cognee (default: gpt-4o-mini for openai, gemini-1.5-flash for google)
COGNEE_LLM_MODEL=gpt-4o-mini

# Embedding provider for Cognee's vector search
# Options: openai | ollama | fastembed
COGNEE_EMBEDDING_PROVIDER=openai

# API key for embedding provider (usually same as LLM key for openai)
COGNEE_EMBEDDING_API_KEY=your_openai_api_key_here

# ─────────────────────────────────────────────────────────────────
# n8n Integration (optional — only needed if running n8n workflow)
# ─────────────────────────────────────────────────────────────────

# n8n webhook URL for demo notifications (leave blank to skip webhook)
N8N_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────
# Decision Engine Thresholds (optional — defaults shown)
# All values are percentages or day counts. Change to tune alert sensitivity.
# ─────────────────────────────────────────────────────────────────

# Demand spike % above baseline → HIGH priority alert
ALERT_PRIORITY_SPIKE_HIGH=30

# Demand spike % above baseline → MEDIUM priority alert
ALERT_PRIORITY_SPIKE_MEDIUM=20

# Demand drop % below baseline → HIGH priority alert
ALERT_PRIORITY_DROP_HIGH=30

# Demand drop % below baseline → MEDIUM priority alert
ALERT_PRIORITY_DROP_MEDIUM=20

# Stock coverage days < this → HIGH priority (immediate restock)
ALERT_COVERAGE_DAYS_HIGH=3

# Stock coverage days < this → MEDIUM priority (plan restock)
ALERT_COVERAGE_DAYS_MEDIUM=7